# Parte local de variables de entorno necesarias para el funcionamiento de la aplicación en entorno local

# -------------------
# Django y enrutamiento
# -------------------

DEBUG=True # True en local, False en producción
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost # En AWS, es la misma que LB_IP y/o dominio en topología-aws.env
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080 # En AWS, es la misma que REDIS_IP en topología-aws.env

# -------------------
# MariaDB
# -------------------
DJANGO_DB_NAME=getbetterDB
DJANGO_DB_USER=django
DJANGO_DB_PASS=django123
DB_ENGINE=django.db.backends.mysql
DB_HOST=mariadb # En AWS, es la misma que DB_IP en topología-aws.env
RUN_MIGRATIONS=1 # Se lanzan migraciones porque es entorno dev y flexible

# -------------------
# Redis
# -------------------
REDIS_HOST=redis # En AWS, es la misma que REDIS_IP en topología-aws.env

# -------------------
# AWS-S3
# -------------------
AWS_S3=False # No usa S3 sino almacenamiento en el contenedor docker o volument compartido con host

